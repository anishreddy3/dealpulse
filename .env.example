# VITE_GEMINI_API_KEY (Optional): For client-side Gemini Flash generation on Cloudflare Pages/Vite.
# If omitted, DealPulse runs seamlessly in 100% offline deterministic demo mode with all local fixtures.
VITE_GEMINI_API_KEY=

# GEMINI_API_KEY (Optional): Server-side Gemini API key if running behind a backend proxy.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL=
