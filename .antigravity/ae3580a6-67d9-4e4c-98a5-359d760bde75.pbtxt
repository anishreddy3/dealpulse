    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { DemoScenario } from \'../types/dealpulse\';\n\nexport const SCENARIO_A: DemoScenario = {\n  id: \'scenario_a\',\n  name: \'Expanding Enterprise \342\200\224 Champion Weak\',\n  tagline: \'Mid-stage deal with active evaluation but uncommitted Economic Buyer and unverified ROI metrics.\',\n  riskCategory: \'medium\',\n  baselineRiskScore: 54,\n  opportunity: {\n    id: \'OPP-8921\',\n    accountName: \'CloudScale Dynamics\',\n    industry: \'DevOps & Cloud Infrastructure\',\n    arr: 185000,\n    stage: \'Stage 3 - Validation & Technical Evaluation\',\n    closeDate: \'2026-10-15\',\n    healthScore: 62,\n    primaryContact: {\n      name: \'Dan Henderson\',\n      role: \'VP of Platform Engineering\',\n      sentiment: \'Encouraging but overwhelmed\',\n    },\n    economicBuyer: {\n      name: \'Marcus Vance\',\n      role: \'Chief Financial Officer\',\n      status: \'unidentified\',\n    },\n    competitors: [\'Datadog APM\', \'Dynatrace Enterprise\'],\n    techStack: [\'Kubernetes\', \'AWS\', \'Terraform\', \'Snowflake\'],\n    lastActivityDate: \'2026-08-18\',\n    assignedAe: \'Sarah Jenkins (Enterprise AE)\',\n  },\n  transcript: [\n    {\n      id: \'t-1\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'00:45\',\n      text: \'Thanks for jumping on Dan and Elena. We wanted to review your platform telemetry benchmarks from the two-week trial.\',\n      sentiment: \'positive\',\n    },\n    {\n      id: \'t-2\',\n      speaker: \'Dan Henderson\',\n      role: \'VP of Platform Eng (CloudScale)\',\n      timestamp: \'01:12\',\n      text: \"The trial went really well on our end. My SRE leads love the unified incident triage view. It definitely saves them hours during P1 outages.\",\n      meddpiccTag: \'identify_pain\',\n      sentiment: \'positive\',\n    },\n    {\n      id: \'t-3\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'02:05\',\n      text: \'That is great to hear. Have you been able to quantify the expected dollar savings or MTTR reduction for your executive committee?\',\n      meddpiccTag: \'metrics\',\n      sentiment: \'neutral\',\n    },\n    {\n      id: \'t-4\',\n      speaker: \'Dan Henderson\',\n      role: \'VP of Platform Eng (CloudScale)\',\n      timestamp: \'02:30\',\n      text: \"Honestly, we have not put a hard dollar figure on it yet. We just know our team is burning out on on-call rotations and we need tooling relief.\",\n      meddpiccTag: \'metrics\',\n      sentiment: \'caution\',\n    },\n    {\n      id: \'t-5\',\n      speaker: \'Elena Rostova\',\n      role: \'Director of Cloud Ops (CloudScale)\',\n      timestamp: \'03:15\',\n      text: \'Also keep in mind Datadog came back with a bundled renewal discount that is about 25% lower than your proposal. Our VP of Finance Marcus will definitely look at that.\',\n      meddpiccTag: \'competition\',\n      sentiment: \'caution\',\n    },\n    {\n      id: \'t-6\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'04:10\',\n      text: \'Understood. Is Marcus joining our business case readout next Tuesday, or what is his typical approval criteria for software above $150k?\',\n      meddpiccTag: \'economic_buyer\',\n      sentiment: \'neutral\',\n    },\n    {\n      id: \'t-7\',\n      speaker: \'Dan Henderson\',\n      role: \'VP of Platform Eng (CloudScale)\',\n      timestamp: \'04:45\',\n      text: \"Marcus usually stays out of vendor demos. He just looks at the final 1-page ROI justification and signs off if our department budget absorbs it. I haven\'t pitched him on this line item yet.\",\n      meddpiccTag: \'economic_buyer\',\n      sentiment: \'negative\',\n    },\n    {\n      id: \'t-8\',\n      speaker: \'Elena Rostova\',\n      role: \'Director of Cloud Ops (CloudScale)\',\n      timestamp: \'05:40\',\n      text: \"Right, and if Dan doesn\'t get Marcus\'s explicit blessing before Q3 budget lock next Friday, this will slip into Q4 or get deferred to next fiscal year.\",\n      meddpiccTag: \'decision_process\',\n      sentiment: \'negative\',\n    },\n    {\n      id: \'t-9\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'06:15\',\n      text: \'Got it. Let me partner with you Dan on building that 1-page executive business case with the MTTR benchmark data this Thursday.\',\n      sentiment: \'positive\',\n    },\n  ],\n  expectedSummary: \'Deal exhibits strong technical champion interest but lacks direct Economic Buyer access (Marcus Vance) and lacks a quantified financial ROI model to counter a 25% Datadog renewal discount.\',\n  initialExplanation: \'CloudScale Dynamics is at Stage 3. Champion Dan Henderson loves the product, but Economic Buyer Marcus Vance has not been engaged, and Q3 budget lock is next Friday.\',\n};\n\nexport const SCENARIO_B: DemoScenario = {\n  id: \'scenario_b\',\n  name: \'Late-Stage Legal Block \342\200\224 Paper Process Stalled\',\n  tagline: \'High-value closing deal stalled by strict EU data residency redlines and rigid monthly Compliance Board review.\',\n  riskCategory: \'critical\',\n  baselineRiskScore: 84,\n  opportunity: {\n    id: \'OPP-5420\',\n    accountName: \'GlobalFin Core Systems\',\n    industry: \'Financial Services & Banking Tech\',\n    arr: 350000,\n    stage: \'Stage 4 - Legal & Security Contracting\',\n    closeDate: \'2026-08-31\',\n    healthScore: 38,\n    primaryContact: {\n      name: \'Vikram Mehta\',\n      role: \'Head of Enterprise Security & InfoSec\',\n      sentiment: \'Strict, process-bound\',\n    },\n    economicBuyer: {\n      name: \'Charlotte Dubois\',\n      role: \'Chief Technology Officer\',\n      status: \'engaged\',\n    },\n    competitors: [\'Palo Alto Cortex\', \'In-house Splunk cluster\'],\n    techStack: [\'AWS Frankfurt\', \'HashiCorp Vault\', \'Kafka\', \'PostgreSQL\'],\n    lastActivityDate: \'2026-08-19\',\n    assignedAe: \'Sarah Jenkins (Enterprise AE)\',\n  },\n  transcript: [\n    {\n      id: \'tb-1\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'00:30\',\n      text: \'Hi Rachel and Vikram. We sent over our standard Enterprise Master Services Agreement and DPA on Monday. We are eager to finalize for end-of-month signature.\',\n      sentiment: \'positive\',\n    },\n    {\n      id: \'tb-2\',\n      speaker: \'Rachel Thorne\',\n      role: \'Lead Commercial Counsel (GlobalFin)\',\n      timestamp: \'01:15\',\n      text: \"Sarah, I reviewed your standard DPA. We have non-negotiable redlines on Section 7.2. GlobalFin cannot accept any cross-border telemetry routing outside the Frankfurt AWS availability zone.\",\n      meddpiccTag: \'paper_process\',\n      sentiment: \'negative\',\n    },\n    {\n      id: \'tb-3\',\n      speaker: \'Vikram Mehta\',\n      role: \'Head of InfoSec (GlobalFin)\',\n      timestamp: \'02:00\',\n      text: \"BaFin banking regulations mandate that all audit logs stay strictly in-region. Your current cloud architecture appears to route metadata through US-East for aggregate analytics.\",\n      meddpiccTag: \'decision_criteria\',\n      sentiment: \'negative\',\n    },\n    {\n      id: \'tb-4\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'02:45\',\n      text: \'Our EU dedicated tenant isolates customer payload data. However, telemetry aggregation has an optional regional lock flag. Can we schedule our solutions architect to confirm the configuration?\',\n      sentiment: \'neutral\',\n    },\n    {\n      id: \'tb-5\',\n      speaker: \'Rachel Thorne\',\n      role: \'Lead Commercial Counsel (GlobalFin)\',\n      timestamp: \'03:30\',\n      text: \"Even if technically resolved, our Global Compliance Review Board only convenes on the last Thursday of each month. If we don\'t submit the signed SOC2 Type II addendum and custom DPA by this Thursday 5 PM CET, this deal cannot close until late September.\",\n      meddpiccTag: \'paper_process\',\n      sentiment: \'negative\',\n    },\n    {\n      id: \'tb-6\',\n      speaker: \'Rachel Thorne\',\n      role: \'Lead Commercial Counsel (GlobalFin)\',\n      timestamp: \'04:15\',\n      text: \"Furthermore, our legal policy requires a 5x liability cap for data breach indemnity, whereas your standard agreement caps at 12 months fees paid.\",\n      meddpiccTag: \'paper_process\',\n      sentiment: \'negative\',\n    },\n    {\n      id: \'tb-7\',\n      speaker: \'Vikram Mehta\',\n      role: \'Head of InfoSec (GlobalFin)\',\n      timestamp: \'05:00\',\n      text: \"CTO Charlotte Dubois already authorized the $350k budget, but she signed a corporate directive that no contract passes without Legal & InfoSec zero-exception sign-off.\",\n      meddpiccTag: \'decision_process\',\n      sentiment: \'caution\',\n    },\n    {\n      id: \'tb-8\',\n      speaker: \'Sarah Jenkins\',\n      role: \'Enterprise AE (Us)\',\n      timestamp: \'05:45\',\n      text: \'Understood Rachel and Vikram. I am immediately triggering an emergency review with our Head of Compliance and Legal counsel to get the Frankfurt isolation addendum and liability amendment drafted before Thursday morning.\',\n      meddpiccTag: \'paper_process\',\n      sentiment: \'neutral\',\n    },\n  ],\n  expectedSummary: \'Critical blocker on Paper Process & Legal: Non-negotiable EU BaFin data residency constraints and 5x indemnity cap. Compliance Board submission deadline is this Thursday 5 PM CET, risking $350k ARR slippage.\',\n  initialExplanation: \'GlobalFin is at Stage 4 ($350k ARR). CTO is supportive, but Lead Counsel Rachel Thorne has non-negotiable redlines on EU data residency and 5x liability caps before Thursday cutoff.\',\n};\n\nexport const DEMO_SCENARIOS: Record<string, DemoScenario> = {\n  scenario_a: SCENARIO_A,\n  scenario_b: SCENARIO_B,\n};\n"
    }
